# Copy to .env.local. Keep secrets out of Git. Development needs no credentials.
BETTER_AUTH_URL=http://localhost:3000
# Set a random 32+ character secret for production; local development generates .data/auth-secret.
BETTER_AUTH_SECRET=
# Empty = embedded PostgreSQL (PGlite) on disk. Production requires a PostgreSQL URL.
DATABASE_URL=
PGLITE_PATH=.data/postgres
# Explicit migration command is recommended for production. Auto-migrate is local by default.
RUN_MIGRATIONS=false
# For a single-process local production preview only, never on Vercel/serverless.
ALLOW_LOCAL_DB=false

# demo = synthetic fixture data with a fixed historical timestamp; live never falls back to demo.
MARKET_DATA_MODE=live
TWELVE_DATA_API_KEY=
# Upstream request budget; set according to your licensed plan. Quote + history count separately.
TWELVE_DATA_REQUESTS_PER_MINUTE=8
# Leave empty if the exact contractual delay is unknown.
TWELVE_DATA_DELAY_MINUTES=
FINNHUB_API_KEY=
FINNHUB_REQUESTS_PER_MINUTE=30
# SEC EDGAR needs no API key. Identify the application with a real operator contact email.
SEC_USER_AGENT=
# Optional validated offline SEC bundle, instead of network requests. See docs/FINANCIAL_STATEMENTS.md.
SEC_COMPANYFACTS_FILE=
# Absolute path to a normalized export from an authorized BYMA feed. See docs/PROVIDERS.md.
BYMA_AUTHORIZED_DATA_FILE=

# AI: explicit model selection. OpenAI Responses API with function calling + structured output.
OPENAI_API_KEY=
AI_MODEL=
# Optional alternative provider endpoint; must support Responses, tool calls, and JSON schema.
AI_BASE_URL=
# Shared daily budget when AI is configured. Without AI: 60 technical requests/minute.
AI_DAILY_LIMIT=10

# OAuth callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional password recovery. Requires a verified sender at Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional read-only wallet providers. Ethereum has a public Blockscout fallback.
# Other supported EVM networks become available when this key is configured.
BLOCKSCOUT_API_KEY=
# Empty uses Solana's public mainnet RPC. Configure a dedicated endpoint for larger histories.
SOLANA_RPC_URL=
